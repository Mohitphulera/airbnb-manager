generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// MULTI-TENANT: Owner / User
// ─────────────────────────────────────────
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  businessName    String
  slug            String    @unique  // URL-safe identifier e.g. "mohit-stays"
  logoUrl         String?
  whatsappNumber  String?
  plan            String    @default("FREE") // "FREE" | "PRO"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  properties      Property[]
  tasks           Task[]
  guests          Guest[]
  referrals       Referral[]
  inventoryItems  InventoryItem[]
  saleProperties  SaleProperty[]
  feedbacks       Feedback[]
}

model Property {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String
  location        String
  imageUrls       String?   // JSON string array
  amenities       String?   // JSON string array: ["WiFi","Pool","AC",...]
  type            String    // "OWNED" or "COMMISSION"
  commissionRate  Float?
  pricePerNight   Float
  whatsappNumber  String?
  wifiName        String?
  wifiPassword    String?
  houseRules      String?   // JSON array
  localGuide      String?   // JSON array of {name,type,distance}
  emergencyPhone  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bookings        Booking[]
  expenses        Expense[]
  reviews         Review[]
  bookingRequests BookingRequest[]
}

model Booking {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  customerName    String
  customerPhone   String?
  checkInDate     DateTime
  checkOutDate    DateTime
  totalAmount     Float
  source          String   // "AIRBNB" or "DIRECT" or "OTHER"
  commissionOwed  Float?
  cleaningStatus  String   @default("PENDING") // "PENDING", "IN_PROGRESS", "DONE"
  notes           String?  // Staff notes, key handover, etc.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Expense {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  description     String
  amount          Float
  category        String   // "CLEANING","REPAIR","UTILITY","OTHER"
  date            DateTime
  receiptUrl      String?
  createdAt       DateTime @default(now())
}

model SaleProperty {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String
  location        String
  price           Float
  area            Float?           // in sq ft
  bedrooms        Int?
  bathrooms       Int?
  propertyType    String           // "APARTMENT","VILLA","PLOT","COMMERCIAL","FARMHOUSE"
  status          String   @default("AVAILABLE")  // "AVAILABLE","SOLD","UNDER_NEGOTIATION"
  imageUrls       String?          // JSON string array
  features        String?          // JSON string array: ["Garden","Parking","24x7 Security",...]
  whatsappNumber  String?
  monthlyRentalEstimate Float?     // estimated rental income for ROI calc
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Review {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  guestName       String
  rating          Int      // 1–5
  comment         String?
  createdAt       DateTime @default(now())
}

model BookingRequest {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  guestName       String
  guestPhone      String
  guestEmail      String?
  checkIn         DateTime
  checkOut        DateTime
  guests          Int      @default(1)
  message         String?
  status          String   @default("PENDING") // "PENDING","CONFIRMED","REJECTED","CANCELLED"
  totalAmount     Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Guest {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  email         String?
  totalStays    Int       @default(0)
  totalSpent    Float     @default(0)
  lastCheckIn   DateTime?
  lastCheckOut  DateTime?
  lastProperty  String?
  tags          String?   // JSON array: ["VIP","Repeat","Family"]
  notes         String?
  birthday      DateTime?
  city          String?
  loyaltyTier   String    @default("NEW") // "NEW","BRONZE","SILVER","GOLD","PLATINUM"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, phone])
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  property    String?
  assignedTo  String?
  priority    String    @default("MEDIUM")
  status      String    @default("TODO")
  dueDate     DateTime?
  category    String    @default("CLEANING")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Feedback {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId     String?
  guestName     String
  guestPhone    String?
  propertyName  String
  rating        Int
  cleanliness   Int?
  comfort       Int?
  location      Int?
  valueForMoney Int?
  comment       String?
  wouldReturn   Boolean?
  createdAt     DateTime @default(now())
}

model InventoryItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  property    String
  category    String   @default("TOILETRIES") // TOILETRIES, LINEN, KITCHEN, CLEANING, OTHER
  quantity    Int      @default(0)
  minStock    Int      @default(5)
  unit        String   @default("pcs") // pcs, sets, bottles, rolls, kg
  lastRefilled DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Referral {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrerName  String
  referrerPhone String
  code          String   @unique
  discountPct   Int      @default(10)
  timesUsed     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}
